Io.Oidis.Builder.DAO.Resources.Data({
    $interface: "IProjectSolution",
    nodejsConfig: {
        devDependencies: {
            grapesjs: "0.22.14"
        }
    },
    licensesRegister: {
        grapesjs: {
            version: ">= 0.22.14",
            description: "Free and Open Source Web Builder Framework.",
            author: "Artur Arseniev",
            license: "BSD-3-Clause",
            format: "source code",
            location: ["[application-name][.exe]/resource/libs/Grapesjs"]
        }
    },
    target: {
        resources: {
            grapesjs: {
                input: "dependencies/nodejs/build/node_modules/grapesjs/dist/grapes.min.js",
                output: "resource/libs/Grapesjs/grapes.min.js",
                skipReplace: true
            },
            grapescss: {
                input: "dependencies/nodejs/build/node_modules/grapesjs/dist/css/grapes.min.css",
                output: "resource/libs/Grapesjs/grapes.min.css",
                skipReplace: true
            },
        },
        requestPatterns: {
            grapesjs: "/resource/libs/Grapesjs/*"
        }
    }
});
