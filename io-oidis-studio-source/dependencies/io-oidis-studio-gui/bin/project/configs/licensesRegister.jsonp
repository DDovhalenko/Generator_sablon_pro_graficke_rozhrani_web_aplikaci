Io.Oidis.Builder.DAO.Resources.Data({
    $interface: "IProjectSolution",
    extendsConfig: "dependencies/io-oidis-services/bin/project/configs/licensesRegister.jsonp",
    imports: {
        userControls: "dependencies/io-oidis-usercontrols/bin/project/configs/licensesRegister.jsonp",
    },
    licensesRegister: {
        "io-oidis-studio-gui": {
            location: [
                "[target/]MaintenancePage.html",
                "[target/]/resource/css/[package-name]-[version].min.css",
                "[target/]/resource/graphics/icon.ico",
                "[target/]/resource/esmodules-[build-time]/Io/Oidis/Studio/Gui",
                "[target/]/resource/javascript/loader.min.js",
                "[target/]/test/resource/data/Io/Oidis/Studio/Gui"
            ]
        }
    }
});
