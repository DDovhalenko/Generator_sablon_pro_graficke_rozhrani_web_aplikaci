    $interface: "IProjectSolution",
    name: "io-oidis-studio",
    description: "Project focused on drag-and-drop development of Oidis applications GUI",
    version: "2025.2.0",
    homepage: "www.oidis.io",
    repository: "https://gitlab.com/oidis/io-oidis-studio.git",
    author: {
        name: "Oidis z.s.",
        email: "info@oidis.io"
    },
    license: "Copyright 2016-<? @var build.year ?> Oidis. The BSD-3-Clause license for this file can be found in the LICENSE.txt " +
        "file included with this distribution or at https://spdx.org/licenses/BSD-3-Clause.html#licenseText.",
    dependencies: {
        "io-oidis-localhost": "git+https://gitlab.com/oidis/io-oidis-localhost.git#develop",
        "io-oidis-studio-gui": "git+https://gitlab.com/oidis/io-oidis-studio-gui.git#feature/OID-295"
    },
    loaderClass: "Io.Oidis.Studio.Loader",
    guiLoaderClass: "Io.Oidis.Studio.Gui.Loader",
    imports: {
        commons: "bin/project/configs/commons.jsonp",
        licensesRegister: "bin/project/configs/licensesRegister.jsonp",
        bootstrap: "dependencies/io-oidis-studio-gui/bin/project/configs/bootstrap.jsonp",
